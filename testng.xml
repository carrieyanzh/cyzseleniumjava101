<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LambdaTest Parallel Suite" parallel="classes" thread-count="4">

  <test name="Chrome_Win10">
    <parameter name="browser" value="Chrome"/>
    <parameter name="version" value="128.0"/>
    <parameter name="platform" value="Windows 10"/>
    <classes>
      <class name="org.lambdatest.tests.PlaygroundAssignTests"/>
    </classes>
  </test>

  <test name="Edge_macOS">
    <parameter name="browser" value="MicrosoftEdge"/>
    <parameter name="version" value="127.0"/>
    <parameter name="platform" value="macOS Ventura"/>
    <classes>
      <class name="org.lambdatest.tests.PlaygroundAssignTests"/>
    </classes>
  </test>

  <test name="Firefox_Win11">
    <parameter name="browser" value="Firefox"/>
    <parameter name="version" value="130.0"/>
    <parameter name="platform" value="Windows 11"/>
    <classes>
      <class name="org.lambdatest.tests.PlaygroundAssignTests"/>
    </classes>
  </test>

  <test name="IE_Win10">
    <parameter name="browser" value="Internet Explorer"/>
    <parameter name="version" value="11.0"/>
    <parameter name="platform" value="Windows 10"/>
    <classes>
      <class name="org.lambdatest.tests.PlaygroundAssignTests"/>
    </classes>
  </test>

</suite>
